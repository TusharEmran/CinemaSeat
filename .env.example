# Every value here already has a default baked into docker-compose.yml.
# Copy to .env only when you want to override something.
#
#   cp .env.example .env

# ── Judging hook #2 ───────────────────────────────────────────────────────────
# How long a seat hold survives without payment. Read from the environment at
# startup, never hardcoded. Judges will run the stack with a short value.
HOLD_TTL_SECONDS=120

# ── Ports ─────────────────────────────────────────────────────────────────────
PROXY_PORT=8080
GATEWAY_PORT=9000

# ── Scaling ───────────────────────────────────────────────────────────────────
API_REPLICAS=2

# ── Gateway integration ───────────────────────────────────────────────────────
# The URL the gateway uses to call us back. Inside compose this is the service
# name. When deployed, set it to the public URL of your API.
PUBLIC_BASE_URL=http://api:3000
GATEWAY_TIMEOUT_MS=3000
GATEWAY_CALLBACK_SECRET=dev-callback-secret

# ── Worker ────────────────────────────────────────────────────────────────────
SWEEP_INTERVAL_MS=1000

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
SEED_ON_BOOT=true
RATE_LIMIT_MAX=300
