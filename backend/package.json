{
  "name": "cinemaseat",
  "version": "1.0.0",
  "description": "CinemaSeat Modular Monolith + Event-Driven Layer Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/workers/worker.js",
    "dev": "node src/server.js",
    "gateway": "node gateway/server.js",
    "migrate": "node database/runMigrations.js",
    "seed": "node database/runSeeds.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "dependencies": {
    "amqplib": "^0.10.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.6.14",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
